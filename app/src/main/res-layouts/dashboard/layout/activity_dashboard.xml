<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Welcome Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_lg">
                <TextView
                    android:id="@+id/tv_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chào buổi sáng, Admin!"
                    android:textAppearance="@style/AdminTextAppearance.Title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Thứ Năm, 16 Tháng 4, 2026"
                    android:textAppearance="@style/AdminTextAppearance.Small"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Stats Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">
                <include android:id="@+id/stat_orders_today" layout="@layout/item_stat_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginEnd="@dimen/spacing_sm" android:layout_marginBottom="@dimen/spacing_sm" />
                <include android:id="@+id/stat_revenue" layout="@layout/item_stat_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="@dimen/spacing_sm" />
                <include android:id="@+id/stat_processing" layout="@layout/item_stat_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginEnd="@dimen/spacing_sm" />
                <include android:id="@+id/stat_completed" layout="@layout/item_stat_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
            </GridLayout>

            <!-- 📊 Revenue Chart (Dynamic Bars) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Doanh thu 7 ngày qua"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    
                    <LinearLayout
                        android:id="@+id/chart_bars_container"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <!-- Bars with IDs for dynamic height -->
                        <View android:id="@+id/bar_day_1" android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@color/primary_light" android:backgroundTint="#FFD0BC"/>
                        <View android:id="@+id/bar_day_2" android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@color/primary_light" android:backgroundTint="#FFD0BC"/>
                        <View android:id="@+id/bar_day_3" android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@color/primary_light" android:backgroundTint="#FFD0BC"/>
                        <View android:id="@+id/bar_day_4" android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@color/primary_light" android:backgroundTint="#FFD0BC"/>
                        <View android:id="@+id/bar_day_5" android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@color/primary_light" android:backgroundTint="#FFD0BC"/>
                        <View android:id="@+id/bar_day_6" android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@color/primary_light" android:backgroundTint="#FFD0BC"/>
                        <View android:id="@+id/bar_day_7" android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@color/primary"/>
                    </LinearLayout>
                    
                    <LinearLayout
                        android:id="@+id/chart_labels_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/label_day_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:id="@+id/label_day_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:id="@+id/label_day_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:id="@+id/label_day_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:id="@+id/label_day_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:id="@+id/label_day_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:id="@+id/label_day_7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="HN" android:gravity="center" android:textSize="10sp" android:textColor="@color/primary" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- New Orders -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đơn hàng mới"
                    android:textAppearance="@style/AdminTextAppearance.Subtitle"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/btn_see_all_orders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Xem tất cả"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_recent_order" />

            <!-- Top Items -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top món ăn bán chạy"
                    android:textAppearance="@style/AdminTextAppearance.Subtitle"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_top_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_top_menu" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
